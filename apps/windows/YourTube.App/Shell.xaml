<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Shell" RequestedTheme="Dark" Background="#1c211f">
  <Grid.Resources>
    <SolidColorBrush x:Key="Muted" Color="#acb8ae"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#adc49b"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#96ad85"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#c0d7ae"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#edf0e9"/></Style>
    <Style TargetType="Button"><Setter Property="CornerRadius" Value="5"/></Style>
    <Style x:Key="DownloadPrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="CornerRadius" Value="5"/></Style>
    <Style x:Key="RailLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <DataTemplate x:Key="HistoryRowTemplate"><Grid Padding="14,10" MinHeight="76"/></DataTemplate>
    <DataTemplate x:Key="SubscribedChannelRowTemplate"><Grid Padding="1,2"/></DataTemplate>
    <DataTemplate x:Key="LibraryCardTemplate"><Grid Padding="6"/></DataTemplate>
    <Style x:Key="LibraryCardContainer" TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0"/></Style>
    <DataTemplate x:Key="HomeShelfTemplate">
      <Grid RowSpacing="4" Margin="0,0,0,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False"/>
        <GridView Grid.Row="1" Height="218" Padding="0,0,0,8" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource LibraryCardTemplate}" ItemContainerStyle="{StaticResource LibraryCardContainer}"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1" ItemWidth="240" ItemHeight="205"/></ItemsPanelTemplate></GridView.ItemsPanel>
        </GridView>
      </Grid>
    </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Grid.Row="0" Height="40" Background="Transparent" Padding="16,0,150,0">
    <StackPanel x:Name="AppBrand" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Border Width="27" Height="26" CornerRadius="6" Background="#c0d7ae">
        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="#172019" AutomationProperties.AccessibilityView="Raw"/>
      </Border>
      <TextBlock Text="YourTube" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
  </Border>
  <Grid x:Name="BrowseAndSettings" Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="NavigationRail" Grid.Row="1" Width="166" Padding="11,16" BorderBrush="#36413a" BorderThickness="0,0,1,0">
      <ScrollViewer x:Name="NavigationRailScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
      <StackPanel x:Name="LibraryNavigation" Spacing="4">
        <Button x:Name="HomeButton" Style="{StaticResource RailButton}" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE80F;" FontSize="15"/><TextBlock Text="Home" Style="{StaticResource RailLabel}"/></StackPanel></Button>
        <Button x:Name="SubscriptionsButton" Style="{StaticResource RailButton}" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE714;" FontSize="15"/><TextBlock Text="Subscriptions" Style="{StaticResource RailLabel}"/></StackPanel></Button>
        <Button x:Name="HistoryButton" Style="{StaticResource RailButton}" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE81C;" FontSize="15"/><TextBlock Text="History" Style="{StaticResource RailLabel}"/></StackPanel></Button>
        <Button x:Name="DownloadsButton" Style="{StaticResource RailButton}" AutomationProperties.Name="Downloads"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE896;" FontSize="15"/><TextBlock Text="Downloads" Style="{StaticResource RailLabel}"/></StackPanel></Button>
        <Button x:Name="SettingsButton" Style="{StaticResource RailButton}" AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <FontIcon Glyph="&#xE713;" FontSize="15"/>
            <TextBlock x:Name="SettingsButtonLabel" Text="Settings" Style="{StaticResource RailLabel}"/>
            <Ellipse x:Name="SettingsUpdateDot" Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"
                     IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          </StackPanel>
        </Button>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid x:Name="WorkspaceContent" Grid.Row="1" Grid.Column="1" Margin="19,21,19,0">
    <ScrollViewer x:Name="DownloadsPanel" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Padding="0,0,8,24" Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock x:Name="DownloadsHeading" Text="Downloads" FontSize="29" FontWeight="Bold" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Name="DownloadsSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="DownloadActiveGroup" Spacing="7" Visibility="Collapsed">
            <TextBlock Text="In progress  ·  1" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
            <ContentControl x:Name="DownloadActiveRow" IsTabStop="False" HorizontalContentAlignment="Stretch"/>
          </StackPanel>
          <StackPanel x:Name="DownloadCleanupGroup" Spacing="7" Visibility="Collapsed">
            <TextBlock x:Name="DownloadCleanupHeading" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
            <StackPanel x:Name="DownloadCleanupRows" Spacing="6"/>
          </StackPanel>
          <StackPanel x:Name="DownloadCompletedGroup" Spacing="7" Visibility="Collapsed">
            <TextBlock x:Name="DownloadCompletedHeading" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
            <StackPanel x:Name="DownloadCompletedRows"/>
          </StackPanel>
          <Border x:Name="DownloadsEmpty" Visibility="Collapsed" Padding="14,60" CornerRadius="8" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="6">
              <FontIcon Glyph="&#xE896;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="No downloads yet" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
              <TextBlock Text="Open a video and choose the download arrow in the player." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="DownloadsFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid x:Name="HistoryPanel" Visibility="Collapsed">
      <Grid x:Name="LibraryContent" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="BrowseHeader" ColumnSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="2"><TextBlock x:Name="ViewHeading" Text="History" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/><TextBlock x:Name="VideosStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
          <Grid x:Name="BrowseSearch" Grid.Column="1" Width="430" HorizontalAlignment="Left" VerticalAlignment="Center" ColumnSpacing="6" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="BrowseSearchBox" MaxLength="160" AutomationProperties.Name="Search videos"/>
            <Button x:Name="BrowseSearchSubmit" Grid.Column="1" Content="Search" VerticalAlignment="Stretch"/>
            <Button x:Name="BrowseSearchClear" Grid.Column="2" VerticalAlignment="Stretch" Visibility="Collapsed" ToolTipService.ToolTip="Clear search" AutomationProperties.Name="Clear search"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
          </Grid>
          <Button x:Name="RefreshButton" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh feed"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
        </Grid>
        <Grid x:Name="FeedStatus" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ProgressRing x:Name="FeedBusyRing" Width="16" Height="16" Visibility="Collapsed"/>
          <TextBlock x:Name="FeedStatusText" Grid.Column="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="FeedCancelButton" Grid.Column="2" Content="Cancel" Visibility="Collapsed" AutomationProperties.Name="Cancel and clear session"/>
        </Grid>
        <Grid x:Name="LibraryFeeds" Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SubscriptionRail" Width="214" Margin="0,0,16,0" Padding="0,0,10,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed">
          <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Subscribed Channels" Margin="10,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
            <ListView x:Name="ChannelsList" Grid.Row="1" Padding="0,0,8,0" ItemTemplate="{StaticResource SubscribedChannelRowTemplate}" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Subscribed channels">
              <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
            </ListView>
          </Grid>
        </Border>
        <GridView x:Name="HistoryList" Grid.Column="1" Padding="0,0,8,0" ItemTemplate="{StaticResource LibraryCardTemplate}" ItemContainerStyle="{StaticResource LibraryCardContainer}" IsItemClickEnabled="True" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Watch history">
          <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="212"/></ItemsPanelTemplate></GridView.ItemsPanel>
          <GridView.Footer><Button x:Name="FeedRetryButton" Content="Retry loading more videos" Margin="0,0,0,16" HorizontalAlignment="Center" Visibility="Collapsed"/></GridView.Footer>
        </GridView>
        <ListView x:Name="HomeShelvesList" Grid.Column="1" Padding="0,0,8,0" SelectionMode="None" Visibility="Collapsed"
                  ItemTemplate="{StaticResource HomeShelfTemplate}"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Home shelves">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
          <ListView.Footer><Button x:Name="HomeRetryButton" Content="Retry loading more rows" Margin="0,0,0,16" HorizontalAlignment="Center" Visibility="Collapsed"/></ListView.Footer>
        </ListView>
        <Grid x:Name="SearchResultsPanel" Grid.Column="1" RowSpacing="8" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="SearchResultsStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
          <GridView x:Name="SearchResultsList" Grid.Row="1" Padding="0,0,8,0" ItemTemplate="{StaticResource LibraryCardTemplate}" ItemContainerStyle="{StaticResource LibraryCardContainer}" IsItemClickEnabled="True" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results">
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" ItemHeight="212"/></ItemsPanelTemplate></GridView.ItemsPanel>
          </GridView>
        </Grid>
        </Grid>
      </Grid>
    </Grid>
    <ScrollViewer x:Name="SignInPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="18" Margin="0,20,0,20">
        <TextBlock Text="Your account. Your history." FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Authorize YourTube using a device code. Your password stays with Google; no sign-in page is embedded here. A refresh token is stored in Windows Credential Manager." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="Experimental, unsupported YouTube TV integration. Google may reject activation or limit account access." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="SignInButton" Content="Sign in with device code"/><Button x:Name="RestoreButton" Content="Retry saved login"/></StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="DevicePanel" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
      <TextBlock Text="Activate YourTube" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Open Google's activation page and enter the code below. Authorization completes here automatically; the browser only opens when you choose the button." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="DeviceCode" FontFamily="Consolas" FontSize="36" IsTextSelectionEnabled="True" AutomationProperties.Name="Device activation code"/>
      <TextBlock x:Name="ExpiryText" Foreground="{StaticResource Muted}"/>
      <Button x:Name="OpenActivationButton" Content="Open activation page in browser" IsEnabled="False"/>
    </StackPanel>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
        <ContentControl x:Name="SettingsHost" HorizontalContentAlignment="Stretch"/>
        <StackPanel Spacing="8">
          <TextBlock Text="Playback" FontSize="18" FontWeight="SemiBold"/>
          <ComboBox x:Name="StartupQualityChooser" Header="Auto startup quality" MinWidth="180"/>
          <TextBlock Text="Preferred starting quality for Auto. Playback can still adjust to your connection." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="StartupQualityStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <ComboBox x:Name="ReachabilityChecksChooser" Header="Parallel reachability checks" MinWidth="180"/>
          <TextBlock Text="Maximum number of stream reachability checks at once. Changes apply the next time you start or retry a video." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ReachabilityChecksStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <ToggleSwitch x:Name="WatchHistorySync" Header="Update YouTube History" IsOn="True"/>
          <TextBlock x:Name="WatchHistoryHelp" Text="On each time the app opens. Reports playback starts and watched progress to the selected YouTube account. YouTube decides what appears in History." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="WatchHistoryStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Grid>
  <ScrollViewer x:Name="TheaterPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="PlayerStage" Background="Black">
          <MediaPlayerElement x:Name="TheaterPlayer" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" AutomationProperties.Name="Native video player"/>
          <Border x:Name="PlayerVideoHitArea" Background="Transparent" IsDoubleTapEnabled="False" AutomationProperties.AccessibilityView="Raw"/>
          <Border x:Name="PlayerTapFeedback" Width="72" Height="72" CornerRadius="36" Background="#B3000000"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
            <FontIcon x:Name="PlayerTapIcon" FontSize="30" Foreground="White" AutomationProperties.AccessibilityView="Raw"/>
          </Border>
          <ProgressRing x:Name="PlayerBusyRing" Width="36" Height="36" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Grid x:Name="PlayerOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" AutomationProperties.Name="Playback controls">
            <StackPanel x:Name="PlayerTransport" VerticalAlignment="Bottom" Padding="12,8,12,6" Visibility="Collapsed">
            <StackPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#E6000000" Offset="0.55"/><GradientStop Color="#F5000000" Offset="1"/></LinearGradientBrush></StackPanel.Background>
            <TextBlock x:Name="PlayerQualityStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            <StackPanel x:Name="PlayerDownloadFeedback" Visibility="Collapsed" Spacing="3">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PlayerDownloadStatus" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="PlayerDownloadCancel" Grid.Column="1" Content="Cancel" AutomationProperties.Name="Cancel download" Visibility="Collapsed"/>
              </Grid>
              <ProgressBar x:Name="PlayerDownloadProgress" Minimum="0" Maximum="100" AutomationProperties.Name="Download progress" Visibility="Collapsed"/>
            </StackPanel>
            <Grid>
              <Slider x:Name="PlayerSeek" Minimum="0" Maximum="1" StepFrequency="0.1" SmallChange="5" LargeChange="10" IsThumbToolTipEnabled="False"
                      Opacity="0" UseSystemFocusVisuals="False" IsHitTestVisible="False" AutomationProperties.Name="Playback position"/>
              <Border x:Name="PlayerChapterFocus" Visibility="Collapsed" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                      BorderThickness="1" CornerRadius="3" Margin="-4,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
              <Canvas x:Name="PlayerChapterTrack" Height="14" VerticalAlignment="Center" Visibility="Collapsed"
                      IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <Canvas x:Name="PlayerChapterSegments"/>
                <Ellipse x:Name="PlayerChapterThumb" Width="14" Height="14" Fill="{StaticResource AccentFillColorDefaultBrush}"/>
              </Canvas>
              <Border x:Name="PlayerSeekHitArea" Background="Transparent" ManipulationMode="None" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <Grid ColumnSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="PlayerPlay" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play"><FontIcon Glyph="&#xE768;" FontSize="18"/></Button>
                <Button x:Name="PlayerMute" Grid.Column="1" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute"><FontIcon Glyph="&#xE767;" FontSize="17"/></Button>
                <Slider x:Name="PlayerVolume" Grid.Column="2" Width="70" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" IsThumbToolTipEnabled="False" AutomationProperties.Name="Volume"/>
                <TextBlock x:Name="PlayerTime" Grid.Column="3" VerticalAlignment="Center" Text="0:00 / 0:00" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PlayerDownloadButton" IsEnabled="False" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Download video" AutomationProperties.Name="Download video"><FontIcon Glyph="&#xE896;" FontSize="18"/><Button.Flyout><MenuFlyout Placement="TopEdgeAlignedRight"/></Button.Flyout></Button>
                <Button x:Name="PlayerSettingsGear" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Player settings" AutomationProperties.Name="Player settings"><FontIcon Glyph="&#xE713;" FontSize="18"/><Button.Flyout><MenuFlyout Placement="TopEdgeAlignedRight"/></Button.Flyout></Button>
                <Button x:Name="PlayerFullscreen" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Fullscreen" AutomationProperties.Name="Fullscreen"><FontIcon Glyph="&#xE740;" FontSize="18"/></Button>
              </StackPanel>
            </Grid>
            </StackPanel>
            <Canvas IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
              <Border x:Name="PlayerSeekPreview" Visibility="Collapsed" IsHitTestVisible="False" Width="200"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="6" Padding="6">
                <StackPanel Spacing="4">
                  <Canvas x:Name="PlayerSeekThumbnail" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Image x:Name="PlayerSeekSheet" Stretch="Fill"/>
                  </Canvas>
                  <TextBlock x:Name="PlayerSeekPreviewLabel" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
            </Canvas>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="7">
              <StackPanel.Resources>
                <ResourceDictionary>
                  <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#414141"/>
                      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#242424"/>
                      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    </ResourceDictionary>
                  </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
              </StackPanel.Resources>
              <Button x:Name="PlayerProgressButton" Width="36" Height="36" Padding="0" Background="#B3000000"
                      Foreground="White" BorderThickness="0" CornerRadius="18"
                      ToolTipService.ToolTip="Playback progress" AutomationProperties.Name="Playback progress">
                <FontIcon Glyph="&#xE700;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"/></Button.Flyout>
              </Button>
              <Button x:Name="PlayerCloseButton" Width="36" Height="36" Padding="0" Background="#B3000000"
                      Foreground="White" BorderThickness="0" CornerRadius="18"
                      ToolTipService.ToolTip="Close video" AutomationProperties.Name="Close video">
                <FontIcon Glyph="&#xE711;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
              </Button>
            </StackPanel>
          </Grid>
      </Grid>
      <StackPanel x:Name="TheaterDetails" Grid.Row="1" Padding="28,20,28,28" Spacing="14">
        <TextBlock x:Name="PlayerTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlayerAuthor" Foreground="#c0d7ae" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlayerError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="PlayerRetryButton" Content="Retry native playback" Visibility="Collapsed"/>
          <Button x:Name="PlayerOpenYouTubeButton" Content="Open YouTube"/>
        </StackPanel>
        <TextBlock x:Name="PlayerBrowserNotice" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="PlayerDescription" TextWrapping="Wrap" MaxHeight="180" IsTextSelectionEnabled="True"/>
        <ContentControl x:Name="PlayerQueueHeader" HorizontalContentAlignment="Stretch" IsTabStop="False"/>
        <ListView x:Name="PlayerQueue" ItemTemplate="{StaticResource HistoryRowTemplate}" IsItemClickEnabled="True" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Up next from current feed">
          <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Width" Value="280"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
        </ListView>
      </StackPanel>
    </Grid>
  </ScrollViewer>
  <Grid x:Name="ShellFooter" Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="AccountButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,5,0,8" Padding="6,3" MinHeight="34" Background="Transparent" BorderThickness="0" Visibility="Collapsed" AutomationProperties.Name="YouTube account">
      <Grid ColumnSpacing="7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="26" Height="26" CornerRadius="13" Background="#c0d7ae" AutomationProperties.AccessibilityView="Raw">
          <Grid>
            <TextBlock x:Name="AccountInitial" Text="?" Foreground="#172019" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse x:Name="AccountAvatar" Width="26" Height="26" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          </Grid>
        </Border>
        <TextBlock x:Name="AccountLabel" Grid.Column="1" MaxWidth="110" Text="Account" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="10" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      </Grid>
      <Button.Flyout><MenuFlyout Placement="TopEdgeAlignedLeft"/></Button.Flyout>
    </Button>
    <Border x:Name="ShellStatus" Grid.Column="1" Visibility="Collapsed" Padding="19,8">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="True"/>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Restoring your session…" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Visibility="Collapsed" AutomationProperties.Name="Cancel and clear session"/>
      </Grid>
    </Border>
  </Grid>
</Grid>
