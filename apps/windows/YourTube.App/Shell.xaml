<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Shell" RequestedTheme="Dark" Background="#1c211f">
  <Grid.Resources>
    <SolidColorBrush x:Key="Muted" Color="#acb8ae"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#adc49b"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#96ad85"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#c0d7ae"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#edf0e9"/></Style>
    <Style TargetType="Button"><Setter Property="CornerRadius" Value="5"/></Style>
    <DataTemplate x:Key="HistoryRowTemplate"><Grid Padding="14,10" MinHeight="76"/></DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Grid.Row="0" Background="#242c28" Padding="16,0,150,0">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE714;" FontSize="15" Foreground="#c0d7ae"/><TextBlock Text="YourTube" FontSize="13"/></StackPanel>
  </Border>
  <Grid x:Name="ShellHeader" Grid.Row="1" Padding="28,20" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="8"><TextBlock x:Name="ViewHeading" Text="Your history" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HistoryButton" Content="History" IsEnabled="False"/><Button x:Name="SubscriptionsButton" Content="Subscriptions" IsEnabled="False"/></StackPanel></StackPanel>
    <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" VerticalAlignment="Center" AutomationProperties.Name="Show or hide Settings"/>
    <Button x:Name="SignOutButton" Grid.Column="2" Content="Sign out" VerticalAlignment="Center"/>
  </Grid>
  <Grid x:Name="BrowseAndSettings" Grid.Row="2" Margin="28,0,28,16">
    <Grid x:Name="HistoryPanel" Visibility="Collapsed" RowSpacing="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="AccountChooser" Header="YouTube account" PlaceholderText="Choose an account" HorizontalAlignment="Stretch" AutomationProperties.Name="YouTube account"/>
        <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" VerticalAlignment="Bottom" IsEnabled="False"/>
      </Grid>
      <TextBlock x:Name="FeedDescription" Grid.Row="1" Text="History cards from YouTube TV. These are not timestamped watch events." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      <Grid Grid.Row="2" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="ChannelsPanel" Visibility="Collapsed" RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="ChannelsStatusText" Text="Subscribed channels" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ListView x:Name="ChannelsList" Grid.Row="1" ItemTemplate="{StaticResource HistoryRowTemplate}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Subscribed channels">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
          </ListView>
        </Grid>
        <Grid x:Name="VideosPanel" Grid.ColumnSpan="2" RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="VideosStatusText" Text="History videos" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ListView x:Name="HistoryList" Grid.Row="1" ItemTemplate="{StaticResource HistoryRowTemplate}" IsItemClickEnabled="True" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Watch history">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
          </ListView>
        </Grid>
      </Grid>
      <Button x:Name="LoadMoreButton" Grid.Row="3" Content="Load more" HorizontalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <ScrollViewer x:Name="SignInPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="18" Margin="0,20,0,20">
        <TextBlock Text="Your account. Your history." FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Authorize YourTube using a device code. Your password stays with Google; no sign-in page is embedded here. A refresh token is stored in Windows Credential Manager." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="Experimental, unsupported YouTube TV integration. Google may reject activation or limit account access." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="SignInButton" Content="Sign in with device code"/><Button x:Name="RestoreButton" Content="Retry saved login"/></StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="DevicePanel" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
      <TextBlock Text="Activate YourTube" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Open Google's activation page and enter the code below. Authorization completes here automatically; the browser only opens when you choose the button." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="DeviceCode" FontFamily="Consolas" FontSize="36" IsTextSelectionEnabled="True" AutomationProperties.Name="Device activation code"/>
      <TextBlock x:Name="ExpiryText" Foreground="{StaticResource Muted}"/>
      <Button x:Name="OpenActivationButton" Content="Open activation page in browser" IsEnabled="False"/>
    </StackPanel>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
        <StackPanel Spacing="8">
          <TextBlock Text="Playback" FontSize="18" FontWeight="SemiBold"/>
          <ComboBox x:Name="StartupQualityChooser" Header="Auto startup quality" MinWidth="180"/>
          <TextBlock Text="Preferred starting quality for Auto. Playback can still adjust to your connection." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="StartupQualityStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ContentControl x:Name="SettingsHost" HorizontalContentAlignment="Stretch"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <ScrollViewer x:Name="TheaterPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TheaterHeader" Padding="28,0,28,12" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="PlayerBackButton" Content="Back to videos" Foreground="#c0d7ae"/>
        <TextBlock x:Name="PlayerFeedLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      </Grid>
      <Grid x:Name="PlayerStageSlot" Grid.Row="1">
        <Grid x:Name="PlayerStage" Height="450" Background="Black">
          <MediaPlayerElement x:Name="TheaterPlayer" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" AutomationProperties.Name="Native video player"/>
          <Border x:Name="PlayerVideoHitArea" Background="Transparent" IsDoubleTapEnabled="False" AutomationProperties.AccessibilityView="Raw"/>
          <Border x:Name="PlayerTapFeedback" Width="72" Height="72" CornerRadius="36" Background="#B3000000"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
            <FontIcon x:Name="PlayerTapIcon" FontSize="30" Foreground="White" AutomationProperties.AccessibilityView="Raw"/>
          </Border>
          <ProgressRing x:Name="PlayerBusyRing" Width="36" Height="36" Visibility="Collapsed" IsHitTestVisible="False"/>
          <StackPanel x:Name="PlayerOverlay" VerticalAlignment="Bottom" Padding="12,8,12,6" Visibility="Collapsed" AutomationProperties.Name="Playback controls">
            <StackPanel.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#E6000000" Offset="0.55"/><GradientStop Color="#F5000000" Offset="1"/></LinearGradientBrush></StackPanel.Background>
            <TextBlock x:Name="PlayerQualityStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            <Grid>
              <Slider x:Name="PlayerSeek" Minimum="0" Maximum="1" StepFrequency="0.1" SmallChange="5" LargeChange="10" IsThumbToolTipEnabled="False" IsHitTestVisible="False" AutomationProperties.Name="Playback position"/>
              <Border x:Name="PlayerSeekHitArea" Background="Transparent" ManipulationMode="None" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <Grid ColumnSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="PlayerPlay" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play"><FontIcon Glyph="&#xE768;" FontSize="18"/></Button>
                <Button x:Name="PlayerMute" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute"><FontIcon Glyph="&#xE767;" FontSize="17"/></Button>
                <Slider x:Name="PlayerVolume" Width="70" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" IsThumbToolTipEnabled="False" AutomationProperties.Name="Volume"/>
                <TextBlock x:Name="PlayerTime" VerticalAlignment="Center" Text="0:00 / 0:00" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="PlayerSettingsGear" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Player settings" AutomationProperties.Name="Player settings"><FontIcon Glyph="&#xE713;" FontSize="18"/><Button.Flyout><MenuFlyout Placement="TopEdgeAlignedRight"/></Button.Flyout></Button>
                <Button x:Name="PlayerFullscreen" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Fullscreen" AutomationProperties.Name="Fullscreen"><FontIcon Glyph="&#xE740;" FontSize="18"/></Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Grid>
      <StackPanel x:Name="TheaterDetails" Grid.Row="2" Padding="28,20,28,28" Spacing="14">
        <TextBlock x:Name="PlayerTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlayerAuthor" Foreground="#c0d7ae" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlayerError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="PlayerRetryButton" Content="Retry native playback" Visibility="Collapsed"/>
          <Button x:Name="PlayerOpenYouTubeButton" Content="Open YouTube"/>
        </StackPanel>
        <TextBlock x:Name="PlayerDescription" TextWrapping="Wrap" MaxHeight="180" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="PlayerQueueLabel" FontSize="19" FontWeight="SemiBold"/>
        <ListView x:Name="PlayerQueue" ItemTemplate="{StaticResource HistoryRowTemplate}" IsItemClickEnabled="True" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Up next from current feed">
          <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Width" Value="280"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
        </ListView>
      </StackPanel>
    </Grid>
  </ScrollViewer>
  <Border x:Name="ShellStatus" Grid.Row="3" Background="#242c28" Padding="28,12">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="True"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="Restoring your session…" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Visibility="Collapsed" AutomationProperties.Name="Cancel and clear session"/>
    </Grid>
  </Border>
</Grid>
